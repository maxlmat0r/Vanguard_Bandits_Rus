{
 "file": 369,
 "kind": "quip",
 "lines": [
  {
   "id": 0,
   "en": "From the left?!",
   "ru": "Слева?!"
  },
  {
   "id": 1,
   "en": "There you are!",
   "ru": "Вот ты где!"
  },
  {
   "id": 2,
   "en": "From the right?!",
   "ru": "Справа?!"
  },
  {
   "id": 3,
   "en": "I see you now!",
   "ru": "Теперь я тебя вижу!"
  },
  {
   "id": 4,
   "en": "That was nothing to\nworry about!",
   "ru": "Не о чем\nбеспокоиться!"
  },
  {
   "id": 5,
   "en": "Ha! Weak!",
   "ru": "Ха! Слабо!"
  },
  {
   "id": 6,
   "en": "You hit like a girl!",
   "ru": "Бьёшь, как девчонка!"
  },
  {
   "id": 7,
   "en": "You annoy me.",
   "ru": "Ты меня\nраздражаешь."
  },
  {
   "id": 8,
   "en": "Whoof!!",
   "ru": "Уф!!"
  },
  {
   "id": 9,
   "en": "You're not allowed to\ndo that again!",
   "ru": "Больше так делать\nнельзя!"
  },
  {
   "id": 10,
   "en": "You have gone much\ntoo far!",
   "ru": "Ты зашёл слишком\nдалеко!"
  },
  {
   "id": 11,
   "en": "You will suffer for\nyour actions!",
   "ru": "Ты поплатишься за\nэто!"
  },
  {
   "id": 12,
   "en": "How do you possess\nsuch strength?!",
   "ru": "Откуда у тебя такая\nсила?!"
  },
  {
   "id": 13,
   "en": "What was that?!",
   "ru": "Это что было?!"
  },
  {
   "id": 14,
   "en": "Gwaaah!!",
   "ru": "Гва-а-а!!"
  },
  {
   "id": 15,
   "en": "Damn you! That\nHURT!",
   "ru": "Чтоб тебя! БОЛЬНО\nже!"
  },
  {
   "id": 16,
   "en": "This is embarrassing.\nThis is humiliating!",
   "ru": "Какой стыд. Какое\nунижение!"
  },
  {
   "id": 17,
   "en": "This cannot be! This\nsimply cannot BE!",
   "ru": "Не может быть!\nПросто НЕ МОЖЕТ!"
  },
  {
   "id": 18,
   "en": "I will deny this loss\nto my grave!",
   "ru": "Я до гроба не\nпризнаю поражения!"
  },
  {
   "id": 19,
   "en": "Bugger! Bollocks!!",
   "ru": "Чёрт! Тысяча\nчертей!!"
  },
  {
   "id": 20,
   "en": "From behind?!",
   "ru": "Сзади?!"
  },
  {
   "id": 21,
   "en": "Cowardly fool!",
   "ru": "Трусливый глупец!"
  },
  {
   "id": 22,
   "en": "Are you dazzled by\nmy lightning speed?",
   "ru": "Ослеплён моей\nбыстротой?"
  },
  {
   "id": 23,
   "en": "That feeble attack\nnever had a chance!",
   "ru": "Жалкий удар, без\nшансов!"
  },
  {
   "id": 24,
   "en": "Heh, heh, heh.",
   "ru": "Хе-хе-хе."
  },
  {
   "id": 25,
   "en": "You chose your\nattack quite poorly!",
   "ru": "Неудачно ты выбрал\nатаку!"
  },
  {
   "id": 26,
   "en": "Why do you avoid\nthe inevitable?",
   "ru": "Зачем бежать от\nнеизбежного?"
  },
  {
   "id": 27,
   "en": "You cretin!",
   "ru": "Кретин!"
  },
  {
   "id": 28,
   "en": "D'ohh!",
   "ru": "Тьфу ты!"
  },
  {
   "id": 29,
   "en": "How DARE you!",
   "ru": "Да как ты СМЕЕШЬ!"
  },
  {
   "id": 30,
   "en": "I will not be beaten!\nNot today, not ever!",
   "ru": "Меня не победить! Ни\nсегодня, ни вовек!"
  },
  {
   "id": 31,
   "en": "Thank you! May I\nhave another?!",
   "ru": "Спасибо! Можно ещё?!"
  },
  {
   "id": 32,
   "en": "You have incurred\nmy wrath, fool!",
   "ru": "Ты навлёк мой гнев,\nглупец!"
  },
  {
   "id": 33,
   "en": "Enjoy the rest of your\nshort life!",
   "ru": "Доживай свои\nкороткие дни!"
  },
  {
   "id": 34,
   "en": "Cretin!!",
   "ru": "Кретин!!"
  },
  {
   "id": 35,
   "en": "I won't let you strike\nme so easily!",
   "ru": "Так легко меня не\nударить!"
  },
  {
   "id": 36,
   "en": "NOOOO!!",
   "ru": "НЕ-Е-ЕТ!!"
  },
  {
   "id": 37,
   "en": "URGHH!!",
   "ru": "УРГХ!!"
  },
  {
   "id": 38,
   "en": "I can't let you taint\nmy beautiful ATAC.",
   "ru": "Мой прекрасный\nАТАК не пачкать!"
  },
  {
   "id": 39,
   "en": "You disappoint me!",
   "ru": "Ты меня\nразочаровал!"
  },
  {
   "id": 40,
   "en": "I will not lose to\nyou or anyone!",
   "ru": "Я не проиграю ни\nтебе, ни кому-либо!"
  },
  {
   "id": 41,
   "en": "Winning has always\ncome naturally to me.",
   "ru": "Побеждать мне\nвсегда было легко."
  },
  {
   "id": 42,
   "en": "Remove yourself from\nmy presence, fool!",
   "ru": "Сгинь с глаз моих,\nглупец!"
  },
  {
   "id": 43,
   "en": "This is my victory!",
   "ru": "Это моя победа!"
  },
  {
   "id": 44,
   "en": "Hehhh!!",
   "ru": "Хе-е!!"
  },
  {
   "id": 45,
   "en": "Aargh!!",
   "ru": "Аргх!!"
  },
  {
   "id": 46,
   "en": "Take this!!",
   "ru": "Получай!!"
  },
  {
   "id": 47,
   "en": "Fool!!",
   "ru": "Глупец!!"
  },
  {
   "id": 48,
   "en": "Die!!",
   "ru": "Умри!!"
  },
  {
   "id": 49,
   "en": "Get out of my way!!",
   "ru": "С дороги!!"
  },
  {
