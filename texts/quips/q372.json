{
 "file": 372,
 "kind": "quip",
 "lines": [
  {
   "id": 0,
   "en": "Oh, there you are!",
   "ru": "О, вот ты где!"
  },
  {
   "id": 1,
   "en": "Huh?",
   "ru": "А?"
  },
  {
   "id": 2,
   "en": "Hey, there you are!",
   "ru": "Эй, вот ты где!"
  },
  {
   "id": 3,
   "en": "Huh?!",
   "ru": "А?!"
  },
  {
   "id": 4,
   "en": "Was that a fly, or was\nthat you?",
   "ru": "Это муха была или\nты?"
  },
  {
   "id": 5,
   "en": "Awright, no candy\nfor you! One year!",
   "ru": "Всё, без конфет! На\nцелый год!"
  },
  {
   "id": 6,
   "en": "You're gonna put my\neye out!",
   "ru": "Ты мне так глаз\nвыбьешь!"
  },
  {
   "id": 7,
   "en": "You're in a bad mood.\nHow about a hug?",
   "ru": "Ты не в духе.\nОбнимемся?"
  },
  {
   "id": 8,
   "en": "OW! What'd you go\nand do THAT for?!",
   "ru": "АЙ! Ты зачем ЭТО\nсделал?!"
  },
  {
   "id": 9,
   "en": "Hey, that's gonna\nleave a mark!",
   "ru": "Эй, теперь синяк\nбудет!"
  },
  {
   "id": 10,
   "en": "Waaahhhhh!",
   "ru": "Ва-а-а-а!"
  },
  {
   "id": 11,
   "en": "Stop it, you big bully!",
   "ru": "Перестань, задира!"
  },
  {
   "id": 12,
   "en": "Waauugghh!!",
   "ru": "Ва-а-агх!!"
  },
  {
   "id": 13,
   "en": "Somebody help me!",
   "ru": "Помогите!"
  },
  {
   "id": 14,
   "en": "You chipped my\nlollipop! You DIE!",
   "ru": "Ты сколол мой\nледенец! Тебе КОНЕЦ!"
  },
  {
   "id": 15,
   "en": "I'm gonna get you,\nsucker!",
   "ru": "Я тебя достану,\nлопух!"
  },
  {
   "id": 16,
   "en": "Ahhhh! My armor!\nMy--candy!!",
   "ru": "А-а-а! Мои доспехи!\nМои... конфеты!!"
  },
  {
   "id": 17,
   "en": "It hurts me so bad!\nI want my mommy!!",
   "ru": "Так больно! Хочу к\nмамочке!!"
  },
  {
   "id": 18,
   "en": "Why are you being so\nmean to me?!",
   "ru": "Ну почему ты такой\nзлой?!"
  },
  {
   "id": 19,
   "en": "Everything I see is\nbright white!",
   "ru": "Всё вокруг стало\nбелым-белым!"
  },
  {
   "id": 20,
   "en": "Yeeeowwww!!",
   "ru": "Уй-юй-юй!!"
  },
  {
   "id": 21,
   "en": "Attacking from\nbehind isn't fair!",
   "ru": "Сзади нападать\nнечестно!"
  },
  {
   "id": 22,
   "en": "Keep that up and I\nwon't give you candy!",
   "ru": "Будешь так —\nконфет не дам!"
  },
  {
   "id": 23,
   "en": "What more can I say?\nYou SUCK!",
   "ru": "Что тут скажешь?\nТы ОТСТОЙ!"
  },
  {
   "id": 24,
   "en": "Missed me! Ha, ha!",
   "ru": "Мимо! Ха-ха!"
  },
  {
   "id": 25,
   "en": "Try a little harder\nnext time!",
   "ru": "В следующий раз\nстарайся лучше!"
  },
  {
   "id": 26,
   "en": "That's really mean,\ndodging like that!",
   "ru": "Так уворачиваться\n— это подло!"
  },
  {
   "id": 27,
   "en": "Why won't you let me\nhit you?!",
   "ru": "Ну дай же тебя\nстукнуть!"
  },
  {
   "id": 28,
   "en": "Hey, now!",
   "ru": "Эй, ну-ну!"
  },
  {
   "id": 29,
   "en": "I really tried hard\nthat time, too...",
   "ru": "А я ведь так\nстарался..."
  },
  {
   "id": 30,
   "en": "I'm just taking my\ntime, that's all!",
   "ru": "Я просто не спешу,\nвот и всё!"
  },
  {
   "id": 31,
   "en": "Urrrrkkk!",
   "ru": "Кха-а!"
  },
  {
   "id": 32,
   "en": "I'll definitely get you\nback for that!",
   "ru": "Я тебе это ещё\nприпомню!"
  },
  {
   "id": 33,
   "en": "Okay, that is quite\nenough of THAT!",
   "ru": "Так, хватит уже\nЭТОГО!"
  },
  {
   "id": 34,
   "en": "Ha, ha!",
   "ru": "Ха-ха!"
  },
  {
   "id": 35,
   "en": "You're silly!",
   "ru": "Ты смешной!"
  },
  {
   "id": 36,
   "en": "Uwaaaaah!",
   "ru": "У-ва-а-а!"
  },
  {
   "id": 37,
   "en": "You're too strong!",
   "ru": "Ты слишком\nсильный!"
  },
  {
   "id": 38,
   "en": "Even I saw you\ncoming that time!",
   "ru": "Даже я тебя\nзаметил!"
  },
  {
   "id": 39,
   "en": "What'd you do?!",
   "ru": "Ты что сделал?!"
  },
  {
   "id": 40,
   "en": "Do you smell what\nBarlow is cookin'?",
   "ru": "Чуешь, что Барлоу\nприготовил?"
  },
  {
   "id": 41,
   "en": "Candy tastes great\nafter a workout.",
   "ru": "После разминки\nконфетки — вкусно!"
  },
  {
   "id": 42,
   "en": "Victory is even better\nthan candy!",
   "ru": "Победа даже лучше\nконфет!"
  },
  {
   "id": 43,
   "en": "See that, guys? I'm a\nbig, strong soldier!",
   "ru": "Видали? Я большой,\nсильный солдат!"
  },
  {
   "id": 44,
   "en": "Hey!",
   "ru": "Эй!"
  },
  {
   "id": 45,
   "en": "Ha!",
   "ru": "Ха!"
  },
  {
   "id": 46,
   "en": "I can DO this!",
   "ru": "Я СМОГУ!"
  },
  {
   "id": 47,
   "en": "I will protect peace\nand candy!",
   "ru": "Я защищу мир и\nконфеты!"
  },
  {
   "id": 48,
   "en": "Here we go!",
   "ru": "Поехали!"
  },
  {
   "id": 49,
   "en": "Here I come!",
   "ru": "Иду!"
  },
  {
   "id": 50,
   "en": "I'll get you!",
   "ru": "Я тебя достану!"
  },
  {
   "id": 51,
   "en": "You're in my way.\nNow get out of it.",
   "ru": "Ты мне мешаешь.\nУйди."
  },
  {
   "id": 52,
   "en": "Get hit, okay?",
   "ru": "Получи, ладно?"
  },
  {
   "id": 53,
