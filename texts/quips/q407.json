  {
   "id": 0,
   "en": "Left!",
   "ru": "Слева!"
  },
  {
   "id": 1,
   "en": "Enemy spotted!",
   "ru": "Враг замечен!"
  },
  {
   "id": 2,
   "en": "Right!",
   "ru": "Справа!"
  },
  {
   "id": 3,
   "en": "Enemy located!",
   "ru": "Враг обнаружен!"
  },
  {
   "id": 4,
   "en": "That attack was\npathetic, soldier!",
   "ru": "Жалкая атака,\nсолдат!"
  },
  {
   "id": 5,
   "en": "Please! Can't you do\nbetter than that?!",
   "ru": "Умоляю! Неужели\nнельзя лучше?!"
  },
  {
   "id": 6,
   "en": "Thank you! I needed\na wake-up call!",
   "ru": "Спасибо! Мне надо\nбыло взбодриться!"
  },
  {
   "id": 7,
   "en": "Huh?",
   "ru": "А?"
  },
  {
   "id": 8,
   "en": "Oooof!",
   "ru": "Ух!"
  },
  {
   "id": 9,
   "en": "You're good!",
   "ru": "А ты хорош!"
  },
  {
   "id": 10,
   "en": "What?!",
   "ru": "Что?!"
  },
  {
   "id": 11,
   "en": "Gwaaah!",
   "ru": "Гва-а-ах!"
  },
  {
   "id": 12,
   "en": "Aaarghh!!",
   "ru": "А-а-аргх!!"
  },
  {
   "id": 13,
   "en": "Damn you!!",
   "ru": "Будь ты проклят!!"
  },
  {
   "id": 14,
   "en": "Too--strong!!",
   "ru": "Слишком... силён!!"
  },
  {
   "id": 15,
   "en": "Major damage!!",
   "ru": "Серьёзные\nповреждения!!"
  },
  {
   "id": 16,
   "en": "Waauuugh!!",
   "ru": "Ва-а-а-агх!!"
  },
  {
   "id": 17,
   "en": "It's over!!",
   "ru": "Всё кончено!!"
  },
  {
   "id": 18,
   "en": "This can't be the end\nof the battle for me!",
   "ru": "Неужели для меня\nбой окончен!"
  },
  {
   "id": 19,
   "en": "Gwaaaaaah!!",
   "ru": "Гва-а-а-ах!!"
  },
  {
   "id": 20,
   "en": "From behind?!",
   "ru": "Сзади?!"
  },
  {
   "id": 21,
   "en": "What is THAT?!",
   "ru": "Это ЧТО?!"
  },
  {
   "id": 22,
   "en": "Too easy!",
   "ru": "Слишком просто!"
  },
  {
   "id": 23,
   "en": "You can't hit me!",
   "ru": "Тебе меня не задеть!"
  },
  {
   "id": 24,
   "en": "Too bad!",
   "ru": "Обидно, да?"
  },
  {
   "id": 25,
   "en": "What's wrong?",
   "ru": "Что такое?"
