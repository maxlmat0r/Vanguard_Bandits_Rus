  {
   "id": 35,
   "en": "Stupid!",
   "ru": "Глупо!"
  },
  {
   "id": 36,
   "en": "I won't let you!",
   "ru": "Не позволю!"
  },
  {
   "id": 37,
   "en": "Curse you!",
   "ru": "Будь ты проклят!"
  },
  {
   "id": 38,
   "en": "Saw it coming!",
   "ru": "Я это предвидел!"
  },
  {
   "id": 39,
   "en": "Bastard!",
   "ru": "Мерзавец!"
  },
  {
   "id": 40,
   "en": "The Empire's evil\nends here and now!",
   "ru": "Злу Империи —\nконец!"
  },
  {
   "id": 41,
   "en": "Where is my next\nImperial victim?!",
   "ru": "Где моя следующая\nимперская жертва?!"
  },
  {
   "id": 42,
   "en": "Peace will return to\nthis world!",
   "ru": "В этот мир вернётся\nпокой!"
  },
  {
   "id": 43,
   "en": "We will not lose!",
   "ru": "Мы не проиграем!"
  },
  {
   "id": 44,
   "en": "Hiyaaa!",
