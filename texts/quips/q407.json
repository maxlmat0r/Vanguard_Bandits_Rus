  {
   "id": 26,
   "en": "WHAT?!",
   "ru": "ЧТО?!"
  },
  {
   "id": 27,
   "en": "Damn it all!",
   "ru": "Да чтоб всё\nпровалилось!"
  },
  {
   "id": 28,
   "en": "You dodged me?!",
   "ru": "Ты увернулся?!"
  },
  {
   "id": 29,
   "en": "Uhhh?!",
   "ru": "А-а?!"
  },
  {
   "id": 30,
   "en": "I will survive!",
   "ru": "Я выживу!"
  },
  {
   "id": 31,
   "en": "I won't be defeated!",
   "ru": "Меня не победить!"
  },
  {
   "id": 32,
   "en": "Nooooo!!",
   "ru": "Не-е-е-ет!!"
  },
  {
   "id": 33,
   "en": "Uhhhhh!!",
   "ru": "У-у-у-ух!!"
  },
  {
   "id": 34,
   "en": "There!",
